<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Suppress TreatWarningsAsErrors inherited from root -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!-- Disable MinVer: samples don't need versioning from git tags -->
    <MINVER_DISABLED>1</MINVER_DISABLED>
  </PropertyGroup>
  <!-- Remove MinVer inherited from root Directory.Build.props -->
  <ItemGroup>
    <PackageReference Remove="MinVer" />
  </ItemGroup>
</Project>
